<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Export de demandes Redmine</title>
<style>
  :root {
    --rm-blue: #628db6;
    --rm-blue-dark: #3e5b76;
    --rm-border: #d7d7d7;
    --rm-bg-soft: #f6f6f6;
    --rm-text: #222;
    --rm-muted: #666;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    color: var(--rm-text);
    margin: 0;
    padding: 0;
    line-height: 1.5;
    font-size: 15px;
    background: #fff;
  }
  a { color: var(--rm-blue-dark); }
  .muted { color: var(--rm-muted); font-size: .85em; }

  /* -- Barre supérieure (écran uniquement) -- */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--rm-blue-dark);
    color: #fff;
    padding: .6rem 1.2rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    box-shadow: 0 1px 4px rgba(0,0,0,.2);
  }
  .topbar .topbar-title { font-weight: 600; margin-right: auto; }
  .topbar a, .topbar button {
    color: #fff;
    text-decoration: none;
    font-size: .9rem;
    background: rgba(255,255,255,.15);
    border: 1px solid rgba(255,255,255,.35);
    border-radius: 3px;
    padding: .3rem .7rem;
    cursor: pointer;
  }
  .topbar a:hover, .topbar button:hover { background: rgba(255,255,255,.28); }

  .wrap { max-width: 1000px; margin: 0 auto; padding: 1.5rem 1.5rem 4rem; }

  .report-header h1 {
    font-size: 1.6rem;
    margin: 0 0 .2rem;
    color: var(--rm-blue-dark);
  }
  .report-header p { color: var(--rm-muted); margin: 0 0 1.5rem; }

  /* -- Sommaire -- */
  .toc { margin-bottom: 2.5rem; }
  .toc h2 {
    font-size: 1.2rem;
    border-bottom: 3px solid var(--rm-blue);
    padding-bottom: .4rem;
    margin-bottom: .8rem;
  }
  .toc h3 {
    font-size: 1rem;
    color: #fff;
    background: var(--rm-blue);
    display: inline-block;
    padding: .2rem .7rem;
    border-radius: 3px;
    margin: 1rem 0 .5rem;
  }
  .toc h3 .count { font-weight: 400; opacity: .85; }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc li {
    padding: .3rem .2rem;
    border-bottom: 1px dotted var(--rm-border);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .toc li a { text-decoration: none; }
  .toc li a:hover { text-decoration: underline; }

  /* -- Sections de demande -- */
  .issue-section {
    border-top: 4px solid var(--rm-blue);
    padding-top: 1.2rem;
    margin-top: 2.5rem;
  }
  .issue-section:first-of-type { margin-top: 0; }

  h2.title {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 .2rem;
  }
  h2.title .tracker { color: var(--rm-muted); font-weight: 500; }

  .byline { color: var(--rm-muted); font-size: .85rem; margin: .4rem 0 1.2rem; }

  .attributes {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.5rem;
    background: var(--rm-bg-soft);
    border: 1px solid var(--rm-border);
    border-radius: 4px;
    padding: .8rem 1.2rem;
    margin-bottom: 1.2rem;
  }
  .attributes-col { flex: 1 1 260px; }
  .attributes dl { margin: 0; }
  .attributes dt {
    float: left;
    clear: left;
    width: 130px;
    font-weight: 600;
    color: var(--rm-muted);
    padding: .2rem 0;
  }
  .attributes dd { margin-left: 130px; padding: .2rem 0; min-height: 1.2em; }
  .attributes::after { content: ""; display: block; clear: both; }

  fieldset {
    border: 1px solid var(--rm-border);
    border-radius: 4px;
    margin: 0 0 1.2rem;
    padding: .9rem 1.1rem 1.1rem;
  }
  legend { font-weight: 600; padding: 0 .4rem; color: var(--rm-blue-dark); }

  .relations ul { margin: .2rem 0 .8rem; padding-left: 1.2rem; }
  .relations p { margin: .4rem 0; }
  .issue-ref-outside { color: var(--rm-muted); }
  .issue-ref-outside em { font-style: normal; font-size: .85em; }

  .wiki p:first-child { margin-top: 0; }
  .wiki p:last-child { margin-bottom: 0; }
  .wiki ul, .wiki ol { padding-left: 1.4rem; }
  .wiki pre, .wiki code {
    background: #f2f2f2;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
    padding: .1rem .3rem;
    font-size: .9em;
  }
  .wiki pre { padding: .6rem .8rem; overflow-x: auto; }
  .wiki blockquote {
    border-left: 3px solid var(--rm-border);
    margin: .5rem 0;
    padding: .1rem 0 .1rem 1rem;
    color: var(--rm-muted);
  }
  .wiki img { max-width: 100%; }
  .wiki table { border-collapse: collapse; }
  .wiki table th, .wiki table td { border: 1px solid var(--rm-border); padding: .3rem .6rem; }

  .attachments ul { list-style: none; padding: 0; margin: 0; }
  .attachments li { padding: .3rem 0; }
  .attachments .clip { margin-right: .4rem; }
  .attachments .size { color: var(--rm-muted); font-size: .85em; }

  .journal {
    display: flex;
    gap: .8rem;
    padding: .8rem 0;
    border-top: 1px solid #eee;
  }
  .journal:first-child { border-top: none; padding-top: 0; }
  .journal-avatar {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .75rem;
    font-weight: 700;
  }
  .journal-body { flex: 1 1 auto; min-width: 0; }
  .journal-header { font-size: .88rem; color: var(--rm-muted); margin-bottom: .3rem; }
  .journal-header strong { color: var(--rm-text); }
  .journal-changes { font-size: .88rem; color: #555; margin: 0 0 .4rem; padding-left: 1.1rem; }
  .journal-changes li { margin-bottom: .15rem; }
  .journal-notes { font-size: .95rem; }

  .back-to-toc { font-size: .85rem; margin-top: .3rem; }

  footer.report-footer {
    margin-top: 3rem;
    font-size: .8rem;
    color: var(--rm-muted);
    border-top: 1px solid #eee;
    padding-top: .6rem;
  }

  /* -- Impression / export PDF -- */
  @media print {
    .no-print { display: none !important; }
    html { scroll-behavior: auto; }
    body { font-size: 11.5pt; }
    .wrap { max-width: none; padding: 0; }
    a { color: inherit; text-decoration: none; }
    .toc { page-break-after: always; }
    .issue-section {
      border-top: 2px solid #999;
      page-break-before: always;
    }
    .issue-section:first-of-type { page-break-before: auto; }
    fieldset { break-inside: avoid; }
    .journal { break-inside: avoid; }
  }
</style>
</head>
<body>
  <div class="topbar no-print">
    <span class="topbar-title">Export de demandes Redmine</span>
    <a href="#toc">&uarr; Sommaire</a>
    <button type="button" onclick="window.print()">Imprimer / PDF</button>
  </div>

  <div class="wrap">
    <header class="report-header">
      <h1>Export de demandes</h1>
      <p><%= issues.size %> demande(s) — généré le <%= format_time(Time.current) %>.
      Les notes marquées privées dans Redmine ne sont pas incluses.</p>
    </header>

    <nav class="toc" id="toc">
      <h2>Sommaire</h2>
      <% if groups %>
        <% groups.each do |label, group_issues| %>
          <h3><%= label %> <span class="count">(<%= group_issues.size %>)</span></h3>
          <ul>
            <% group_issues.each do |issue| %>
              <li>
                <a href="#issue-<%= issue.id %>">#<%= issue.id %> — <%= issue.subject %></a>
                <span class="muted"><%= issue.status&.name %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% else %>
        <ul>
          <% issues.each do |issue| %>
            <li>
              <a href="#issue-<%= issue.id %>">#<%= issue.id %> — <%= issue.subject %></a>
              <span class="muted"><%= issue.status&.name %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </nav>

    <main>
      <% issues.each do |issue| %>
        <% journals = journals_by_issue_id[issue.id] || [] %>
        <section class="issue-section" id="issue-<%= issue.id %>">
          <h2 class="title">
            <span class="tracker"><%= issue.tracker&.name %> #<%= issue.id %>:</span>
            <%= issue.subject %>
          </h2>

          <%
            added_ago   = distance_of_time_in_words_to_now(issue.created_on) rescue nil
            updated_ago = distance_of_time_in_words_to_now(issue.updated_on) rescue nil
          %>
          <p class="byline">
            Ajoutée par <strong><%= issue.author&.to_s %></strong>
            <% if added_ago %>il y a <%= added_ago %><% end %>.
            <% if updated_ago %>Mise à jour il y a <%= updated_ago %>.<% end %>
          </p>

          <div class="attributes">
            <div class="attributes-col">
              <dl>
                <dt>Statut</dt><dd><%= issue.status&.name %></dd>
                <dt>Priorité</dt><dd><%= issue.priority&.name %></dd>
                <dt>Assigné à</dt><dd><%= issue.assigned_to&.to_s || '-' %></dd>
                <dt>Catégorie</dt><dd><%= issue.category&.name || '-' %></dd>
              </dl>
            </div>
            <div class="attributes-col">
              <dl>
                <dt>Début</dt><dd><%= issue.start_date ? format_date(issue.start_date) : '-' %></dd>
                <dt>Échéance</dt><dd><%= issue.due_date ? format_date(issue.due_date) : '-' %></dd>
                <dt>Avancement</dt><dd><%= issue.done_ratio %>%</dd>
                <dt>Version cible</dt><dd><%= issue.fixed_version&.name || '-' %></dd>
              </dl>
            </div>
            <% if issue.visible_custom_field_values.any? %>
              <div class="attributes-col">
                <dl>
                  <% issue.visible_custom_field_values.each do |cfv| %>
                    <dt><%= cfv.custom_field.name %></dt><dd><%= cfv.value.to_s.presence || '-' %></dd>
                  <% end %>
                </dl>
              </div>
            <% end %>
          </div>

          <% if issue.parent || issue.children.any? || issue.relations.any? %>
            <fieldset class="relations">
              <legend>Relations</legend>

              <% if issue.parent %>
                <p><strong>Demande parente :</strong> <%= issue_ref_link(issue.parent, report_ids) %></p>
              <% end %>

              <% if issue.children.any? %>
                <p><strong>Sous-tâches (<%= issue.children.size %>) :</strong></p>
                <ul>
                  <% issue.children.each do |child| %>
                    <li><%= issue_ref_link(child, report_ids) %> <span class="muted"><%= child.status&.name %></span></li>
                  <% end %>
                </ul>
              <% end %>

              <% if issue.relations.any? %>
                <p><strong>Demandes liées :</strong></p>
                <ul>
                  <% issue.relations.each do |relation| %>
                    <% other = relation.other_issue(issue) %>
                    <% next if other.nil? %>
                    <li><%= l(relation.label_for(issue)) %> : <%= issue_ref_link(other, report_ids) %></li>
                  <% end %>
                </ul>
              <% end %>
            </fieldset>
          <% end %>

          <fieldset>
            <legend>Description</legend>
            <div class="wiki">
              <%= localize_attachment_links(textilizable(issue, :description, attachments: issue.attachments), issue) %>
            </div>
          </fieldset>

          <% if issue.attachments.any? %>
            <fieldset class="attachments">
              <legend>Pièces jointes (<%= issue.attachments.size %>)</legend>
              <ul>
                <% issue.attachments.each do |a| %>
                  <li>
                    <span class="clip">&#128206;</span>
                    <a href="../<%= issue.id %>/<%= a.filename %>"><%= a.filename %></a>
                    <span class="size">(<%= number_to_human_size(a.filesize) %>)</span>
                  </li>
                <% end %>
              </ul>
            </fieldset>
          <% end %>

          <fieldset class="history">
            <legend>Historique (<%= journals.size %>)</legend>
            <% if journals.empty? %>
              <p><em>Aucun historique.</em></p>
            <% else %>
              <% palette = ['#628db6', '#3e5b76', '#2a9d8f', '#a76a2a', '#7a4f9e', '#4a7a2a', '#b0562a', '#2a6a7a'] %>
              <% journals.each do |journal| %>
                <%
                  name = journal.user&.to_s || 'Utilisateur supprimé'
                  initials = name.split(/\s+/).map { |w| w[0] }.first(2).join.upcase
                  color = palette[name.bytes.sum % palette.size]
                %>
                <div class="journal">
                  <div class="journal-avatar" style="background:<%= color %>"><%= initials %></div>
                  <div class="journal-body">
                    <div class="journal-header">
                      <strong><%= name %></strong> — <%= format_time(journal.created_on) %>
                    </div>
                    <% detail_strings = details_to_strings(journal.details) %>
                    <% if detail_strings.any? %>
                      <ul class="journal-changes">
                        <% detail_strings.each do |d| %>
                          <li><%= d %></li>
                        <% end %>
                      </ul>
                    <% end %>
                    <% if journal.notes.present? %>
                      <div class="journal-notes wiki">
                        <%= localize_attachment_links(textilizable(journal, :notes, attachments: issue.attachments), issue) %>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </fieldset>

          <p class="back-to-toc no-print"><a href="#toc">&uarr; Retour au sommaire</a></p>
        </section>
      <% end %>
    </main>

    <footer class="report-footer">
      Export généré le <%= format_time(Time.current) %> par le plugin d'export/import des demandes.
    </footer>
  </div>
</body>
</html>
