<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Export de demandes Redmine</title>
<style>
  /* ================================================================
     STYLE ÉPURÉ PROCHE DU PDF REDMINE - Refonte 2026-09
     Inspiré de issues.pdf (liste) et test2-1.pdf (fiche)
     ================================================================ */
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: "Helvetica Neue", Helvetica, Arial, "DejaVu Sans", sans-serif;
    color: #000;
    margin: 0;
    padding: 0;
    line-height: 1.45;
    font-size: 9pt;
    background: #fff;
    orphans: 3;
    widows: 3;
  }
  a { color: #000; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .muted { color: #666; }

  /* Barre écran uniquement */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #222;
    color: #fff;
    padding: 6px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    border-bottom: 1px solid #000;
  }
  .topbar .topbar-title { font-weight: 600; margin-right: auto; letter-spacing: .2px; }
  .topbar a, .topbar button {
    color: #fff;
    text-decoration: none;
    font-size: 11px;
    background: #444;
    border: 1px solid #666;
    border-radius: 3px;
    padding: 4px 10px;
    cursor: pointer;
  }
  .topbar a:hover, .topbar button:hover { background: #555; }

  .wrap { max-width: 1080px; margin: 0 auto; padding: 14px 18px 40px; }

  /* En-tête rapport */
  .report-header {
    text-align: center;
    border-bottom: 1.4pt solid #000;
    padding-bottom: 10px;
    margin-bottom: 14px;
  }
  .report-header h1 {
    font-size: 14pt;
    font-weight: 700;
    margin: 0 0 4px 0;
    letter-spacing: .1px;
  }
  .report-header .subtitle {
    font-size: 8.5pt;
    color: #444;
    margin: 0;
  }

  /* Bloc infos requête - style PDF */
  .query-info {
    border: 0.5pt solid #bbb;
    background: #fafafa;
    padding: 7px 10px;
    margin-bottom: 14px;
    font-size: 7.8pt;
    line-height: 1.4;
    color: #222;
  }
  .query-info .row { display: flex; flex-wrap: wrap; gap: 14px; }
  .query-info .item { white-space: nowrap; }
  .query-info strong { font-weight: 700; }
  .query-info .filters { margin-top: 4px; word-break: break-word; white-space: normal; }

  /* Sommaire */
  .toc { margin-bottom: 18px; }
  .toc h2 {
    font-size: 11pt;
    font-weight: 700;
    border-bottom: 0.9pt solid #000;
    padding-bottom: 3px;
    margin: 0 0 8px 0;
  }
  .toc .meta {
    font-size: 7.8pt;
    color: #555;
    margin-bottom: 8px;
  }
  .toc table.issues-toc {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.8pt;
    table-layout: auto;
  }
  .toc table.issues-toc th {
    background: #eeeeee;
    border: 0.5pt solid #999;
    padding: 3px 5px;
    text-align: left;
    font-weight: 700;
    white-space: nowrap;
  }
  .toc table.issues-toc td {
    border: 0.5pt solid #bbb;
    padding: 3px 5px;
    vertical-align: top;
  }
  .toc table.issues-toc tr:nth-child(even) td { background: #f9f9f9; }
  .toc table.issues-toc tr:hover td { background: #f0f0f0; }
  .toc table.issues-toc tr.group-header td {
    background: #d5d5d5;
    font-weight: 700;
    border: 0.5pt solid #999;
    padding: 4px 6px;
  }
  .toc table.issues-toc a { text-decoration: underline; }
  .sort-indicator { font-size: 7pt; margin-left: 2px; }

  /* Sections demandes - style fiche PDF */
  .issue-section {
    border-top: 1.2pt solid #000;
    padding-top: 10px;
    margin-top: 20px;
    page-break-inside: avoid;
  }
  .issue-section:first-of-type { margin-top: 10px; }

  h2.title {
    font-size: 11pt;
    font-weight: 700;
    margin: 0 0 3px 0;
    line-height: 1.3;
  }
  h2.title .tracker {
    font-weight: 400;
    color: #444;
    font-size: 10pt;
  }
  .byline {
    color: #555;
    font-size: 7.5pt;
    margin: 0 0 8px 0;
  }
  .byline strong { color: #000; }

  /* Attributs - 2 colonnes comme PDF */
  table.attributes {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 10px;
    font-size: 8.2pt;
  }
  table.attributes th {
    text-align: left;
    padding: 3px 5px;
    background: #f0f0f0;
    border: 0.5pt solid #bbb;
    font-weight: 600;
    white-space: nowrap;
    width: 15%;
  }
  table.attributes td {
    padding: 3px 5px;
    border: 0.5pt solid #bbb;
    width: 35%;
    vertical-align: top;
  }

  /* Sections génériques */
  .section { margin-bottom: 12px; }
  .section h3 {
    font-size: 9.5pt;
    font-weight: 700;
    border-bottom: 0.7pt solid #000;
    padding-bottom: 2px;
    margin: 0 0 6px 0;
  }
  .section .wiki {
    font-size: 8.8pt;
    line-height: 1.45;
    padding: 0;
  }
  .wiki p { margin: 5px 0; }
  .wiki p:first-child { margin-top: 0; }
  .wiki ul, .wiki ol { padding-left: 18px; margin: 5px 0; }
  .wiki pre, .wiki code {
    background: #f5f5f5;
    border: 0.5pt solid #ccc;
    padding: 1px 3px;
    font-size: 7.8pt;
    font-family: "Courier New", monospace;
  }
  .wiki pre { padding: 6px 8px; margin: 6px 0; white-space: pre-wrap; word-wrap: break-word; }
  .wiki blockquote {
    border-left: 2pt solid #bbb;
    margin: 6px 0;
    padding: 2px 0 2px 8px;
    color: #555;
    font-style: italic;
  }
  .wiki img { max-width: 100%; border: 0.5pt solid #bbb; margin: 6px 0; }
  .wiki table { border-collapse: collapse; width: 100%; margin: 6px 0; font-size: 8pt; }
  .wiki table th, .wiki table td { border: 0.5pt solid #bbb; padding: 3px 5px; }
  .wiki table th { background: #eee; font-weight: 600; text-align: left; }

  /* Relations */
  .relations ul { margin: 3px 0 8px 16px; padding: 0; font-size: 8.2pt; }
  .relations p { margin: 3px 0; font-size: 8.2pt; }
  .issue-ref-outside { color: #666; }
  .issue-ref-outside em { font-style: italic; font-size: 7.5pt; }

  /* Pièces jointes */
  .attachments ul { list-style: none; padding: 0; margin: 0; }
  .attachments li { padding: 3px 0; border-bottom: 0.5pt dotted #bbb; font-size: 8.2pt; display: flex; gap: 6px; }
  .attachments .size { color: #666; font-size: 7.5pt; margin-left: auto; }

  /* Journaux / Notes - style PDF épuré */
  .journal {
    border-top: 0.5pt dotted #999;
    padding: 6px 0;
    font-size: 8.5pt;
    page-break-inside: avoid;
  }
  .journal:first-of-type { border-top: none; padding-top: 0; }
  .journal-header {
    font-size: 7.8pt;
    color: #555;
    margin-bottom: 4px;
  }
  .journal-header strong { color: #000; font-weight: 600; }
  .journal-details {
    font-size: 7.8pt;
    color: #333;
    margin-bottom: 4px;
    padding-left: 0;
  }
  .journal-details ul { margin: 2px 0 2px 14px; padding: 0; }
  .journal-notes { font-size: 8.5pt; }

  .back-to-toc { font-size: 7.5pt; margin-top: 8px; text-align: right; }
  .back-to-toc a { color: #444; text-decoration: underline; }

  footer.report-footer {
    margin-top: 20px;
    font-size: 7pt;
    color: #666;
    border-top: 0.5pt solid #bbb;
    padding-top: 8px;
    text-align: center;
  }

  @media print {
    .no-print { display: none !important; }
    html { scroll-behavior: auto; }
    body { font-size: 8.5pt; }
    .wrap { max-width: none; padding: 0; }
    a { color: #000; text-decoration: none; }
    .toc { page-break-after: always; }
    .issue-section { border-top: 1pt solid #000; page-break-before: always; }
    .issue-section:first-of-type { page-break-before: auto; }
    .section, .journal, table.attributes { break-inside: avoid; }
    @page { size: A4; margin: 14mm 12mm 16mm 12mm; }
  }
</style>
</head>
<body>
  <div class="topbar no-print">
    <span class="topbar-title">Export Redmine — <%= issues.size %> demandes</span>
    <a href="#toc">↑ Sommaire</a>
    <button type="button" onclick="window.print()">Imprimer / PDF</button>
    <span style="margin-left:auto; opacity:.7;">Tri: <%= sort_criteria_to_s(query) %></span>
  </div>

  <div class="wrap">
    <header class="report-header">
      <h1><%= query.project ? query.project.name : 'Toutes les demandes' %> — Export</h1>
      <p class="subtitle">
        <%= issues.size %> demande(s) — généré le <%= format_time(Time.current) %> par <%= User.current %>
        <% if query.respond_to?(:name) && query.name.present? && query.name != '_' %> — Requête: <%= query.name %><% end %><br>
        Les notes privées ne sont pas incluses. Pièces jointes dans les dossiers ../&lt;id&gt;/ — Rapport autonome.
      </p>
    </header>

    <%# Bloc infos requête : filtres, tri, groupement, colonnes %>
    <div class="query-info">
      <div class="row">
        <span class="item"><strong>Projet:</strong> <%= query.project ? query.project.name : 'Tous' %></span>
        <span class="item"><strong>Tri:</strong> <%= sort_criteria_to_s(query).presence || 'par défaut (ID desc)' %></span>
        <% if query.respond_to?(:grouped?) && query.grouped? %>
          <span class="item"><strong>Groupé par:</strong> <%= column_caption(query.group_by_column) %></span>
        <% end %>
        <span class="item"><strong>Colonnes:</strong> <%= export_columns.map { |c| column_caption(c) }.join(', ') %></span>
      </div>
      <% if query.filters.present? %>
        <div class="filters"><strong>Filtres:</strong> <%= filters_to_s(query) %></div>
      <% end %>
    </div>

    <%# SOMMAIRE TABLEAU - reprend champs et tri de la requête %>
    <nav class="toc" id="toc">
      <h2>Sommaire — Liste des demandes (<%= issues.size %>)</h2>
      <div class="meta">
        Ordre identique à l'écran au moment de l'export (<%= sort_criteria_to_s(query).presence || 'ID' %>)
        <% if groups %> — Groupé par <%= column_caption(query.group_by_column) %><% end %>
        — Cliquez sur un # pour aller à la fiche.
      </div>

      <table class="issues-toc">
        <thead>
          <tr>
            <th style="width: 40px;">#</th>
            <% export_columns.each do |col| %>
              <%
                is_sorted = sort_criteria.any? { |f, _| f.to_s == col.name.to_s }
                order = sort_criteria.detect { |f, _| f.to_s == col.name.to_s }&.last
              %>
              <th>
                <%= column_caption(col) %>
                <% if is_sorted %><span class="sort-indicator"><%= order == 'desc' ? '▼' : '▲' %></span><% end %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% if groups %>
            <% groups.each do |label, group_issues| %>
              <tr class="group-header"><td colspan="<%= 1 + export_columns.size %>"><%= label %> — <%= group_issues.size %> demande(s)</td></tr>
              <% group_issues.each do |issue| %>
                <tr>
                  <td><a href="#issue-<%= issue.id %>">#<%= issue.id %></a></td>
                  <% export_columns.each do |col| %>
                    <td><%= column_display_value(issue, col) %></td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          <% else %>
            <% issues.each do |issue| %>
              <tr>
                <td><a href="#issue-<%= issue.id %>">#<%= issue.id %></a></td>
                <% export_columns.each do |col| %>
                  <td><%= column_display_value(issue, col) %></td>
                <% end %>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </nav>

    <main>
      <% issues.each do |issue| %>
        <% journals = journals_by_issue_id[issue.id] || [] %>
        <section class="issue-section" id="issue-<%= issue.id %>">
          <h2 class="title">
            <span class="tracker"><%= issue.tracker&.name %> #<%= issue.id %>:</span>
            <%= issue.subject %>
          </h2>

          <%
            added_ago   = distance_of_time_in_words_to_now(issue.created_on) rescue nil
            updated_ago = distance_of_time_in_words_to_now(issue.updated_on) rescue nil
          %>
          <p class="byline">
            Ajoutée par <strong><%= issue.author&.to_s %></strong><% if added_ago %> il y a <%= added_ago %><% end %>.
            <% if updated_ago %>Mise à jour il y a <%= updated_ago %>.<% end %>
            <% if issue.project %>Projet: <%= issue.project.name %>.<% end %>
          </p>

          <table class="attributes">
            <tr>
              <th>Statut</th><td><%= issue.status&.name %></td>
              <th>Priorité</th><td><%= issue.priority&.name %></td>
            </tr>
            <tr>
              <th>Assigné à</th><td><%= issue.assigned_to&.to_s.presence || '-' %></td>
              <th>Catégorie</th><td><%= issue.category&.name || '-' %></td>
            </tr>
            <tr>
              <th>Début</th><td><%= issue.start_date ? format_date(issue.start_date) : '-' %></td>
              <th>Échéance</th><td><%= issue.due_date ? format_date(issue.due_date) : '-' %></td>
            </tr>
            <tr>
              <th>Avancement</th><td><%= issue.done_ratio %>%</td>
              <th>Version cible</th><td><%= issue.fixed_version&.name || '-' %></td>
            </tr>
            <% if issue.visible_custom_field_values.any? %>
              <% issue.visible_custom_field_values.each_slice(2) do |cfv_pair| %>
                <tr>
                  <th><%= cfv_pair[0].custom_field.name %></th><td><%= cfv_pair[0].value.to_s.presence || '-' %></td>
                  <% if cfv_pair[1] %>
                    <th><%= cfv_pair[1].custom_field.name %></th><td><%= cfv_pair[1].value.to_s.presence || '-' %></td>
                  <% else %>
                    <th></th><td></td>
                  <% end %>
                </tr>
              <% end %>
            <% end %>
          </table>

          <% if issue.parent || issue.children.any? || issue.relations.any? %>
            <div class="section relations">
              <h3>Relations</h3>
              <% if issue.parent %>
                <p><strong>Demande parente:</strong> <%= issue_ref_link(issue.parent, report_ids) %></p>
              <% end %>
              <% if issue.children.any? %>
                <p><strong>Sous-tâches (<%= issue.children.size %>):</strong></p>
                <ul>
                  <% issue.children.each do |child| %>
                    <li><%= issue_ref_link(child, report_ids) %> <span class="muted"><%= child.status&.name %></span></li>
                  <% end %>
                </ul>
              <% end %>
              <% if issue.relations.any? %>
                <p><strong>Demandes liées:</strong></p>
                <ul>
                  <% issue.relations.each do |relation| %>
                    <% other = relation.other_issue(issue) %>
                    <% next if other.nil? %>
                    <li><%= l(relation.label_for(issue)) %> : <%= issue_ref_link(other, report_ids) %></li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          <% end %>

          <div class="section">
            <h3>Description</h3>
            <div class="wiki">
              <%= localize_attachment_links(textilizable(issue, :description, attachments: issue.attachments), issue) %>
            </div>
          </div>

          <% if issue.attachments.any? %>
            <div class="section attachments">
              <h3>Pièces jointes (<%= issue.attachments.size %>)</h3>
              <ul>
                <% issue.attachments.each do |a| %>
                  <li>
                    <span>📎</span>
                    <a href="../<%= issue.id %>/<%= a.filename %>"><%= a.filename %></a>
                    <span class="size">(<%= number_to_human_size(a.filesize) %>)</span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%# Notes publiques + détails des changements comme dans le PDF Redmine %>
          <%
            # visible_details (et non details) filtre les changements de champs
            # personnalisés non visibles par l'utilisateur qui exporte — même
            # comportement que l'onglet "Historique" de Redmine, indispensable
            # ici puisque le rapport peut être transmis à des personnes
            # externes. La méthode est ensuite appelée une seule fois par
            # journal pour éviter de recalculer le filtre.
          %>
          <% if journals.any? { |j| j.notes.present? || j.visible_details(User.current).any? } %>
            <div class="section">
              <h3>Historique — Notes (<%= journals.count { |j| j.notes.present? && !j.private_notes? } %>)</h3>
              <% journals.each do |journal| %>
                <% visible_details = journal.visible_details(User.current) %>
                <% next if journal.notes.blank? && visible_details.empty? %>
                <% next if journal.private_notes? && journal.notes.present? %>
                <div class="journal">
                  <div class="journal-header">
                    Mis à jour par <strong><%= journal.user&.to_s || 'Utilisateur supprimé' %></strong>
                    le <%= format_time(journal.created_on) %>
                    <% if journal.private_notes? %><em>(privée - exclue)</em><% end %>
                  </div>
                  <% if visible_details.any? %>
                    <div class="journal-details">
                      <ul>
                        <% details_to_strings(visible_details).each do |s| %>
                          <li><%= s %></li>
                        <% end %>
                      </ul>
                    </div>
                  <% end %>
                  <% if journal.notes.present? && !journal.private_notes? %>
                    <div class="journal-notes wiki">
                      <%= localize_attachment_links(textilizable(journal, :notes, attachments: issue.attachments), issue) %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <p class="back-to-toc no-print"><a href="#toc">↑ Retour au sommaire</a></p>
        </section>
      <% end %>
    </main>

    <footer class="report-footer">
      Export généré le <%= format_time(Time.current) %> par <%= User.current %> — Plugin export/import demandes.<br>
      <%= issues.size %> demande(s), tri: <%= sort_criteria_to_s(query).presence || 'défaut' %>, colonnes: <%= export_columns.map { |c| column_caption(c) }.join(', ') %><br>
      Archive: pièces jointes dans ../&lt;id&gt;/ — Rapport autonome sans connexion requise.
    </footer>
  </div>
</body>
</html>
