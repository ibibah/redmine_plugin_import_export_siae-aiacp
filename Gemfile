source 'https://rubygems.org'

# Utilisé pour générer/lire les archives .zip d'export-import
# (chargé automatiquement par le Gemfile racine de Redmine via
# Dir.glob("plugins/*/Gemfile") — pensez à relancer `bundle install`
# à la racine de Redmine après installation du plugin).
#
# Version fixée précisément (plutôt que "~> 2.3") car certaines sources de
# gems ne résolvent pas toujours cette contrainte proprement ; ajustez si
# besoin selon les versions disponibles dans votre environnement.
gem 'rubyzip', '~> 2.3.0', require: 'zip'
